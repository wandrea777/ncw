{
  "name": "ncw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ncw/web",
    "build": "npm run build -w @ncw/core && npm run build -w @ncw/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "compliance": "node compliance/scripts/compliance-check.mjs",
    "compliance:release": "node compliance/scripts/compliance-check.mjs --release",
    "vuln-watch": "node compliance/scripts/vuln-watch.mjs",
    "incident": "node compliance/scripts/incident.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "dev:api": "npm run dev -w @ncw/api",
    "docs-check": "node scripts/docs-check.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
